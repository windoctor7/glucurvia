# Copia este archivo a .env (no se versiona) y rellena los valores.
TZ=America/Mexico_City

# --- Nightscout ---
# Mínimo 12 caracteres. Es la contraseña de administración de Nightscout.
NS_API_SECRET=cambia-esto-minimo-12-caracteres
# Token de SOLO LECTURA para nuestra API (Nightscout → Admin Tools → Subjects → rol "readable").
NS_READ_TOKEN=

# --- Uploader nightscout-librelink-up ---
# Cuenta SEGUIDORA de LibreLinkUp (la segunda cuenta de correo que invitaste desde LibreLink), no tu cuenta principal.
LINK_UP_USERNAME=
LINK_UP_PASSWORD=
LINK_UP_REGION=LA
LINK_UP_TIME_INTERVAL=1
# Token con permiso de escritura de entries para el uploader (Admin Tools → Subjects → rol "api" o "admin").
NIGHTSCOUT_API_TOKEN=

# --- PostgreSQL ---
POSTGRES_USER=glucurvia
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=glucurvia

# --- API (a partir de la fase 2) ---
ANTHROPIC_API_KEY=
NIGHTSCOUT_URL=http://nightscout:1337
